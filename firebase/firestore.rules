// Nova Games — Firestore Security Rules.
//
// Paste this whole file into the Firebase console: Firestore Database ->
// Rules tab -> replace the contents -> Publish. Re-pasting it is harmless.
//
// The site ships a public apiKey in source, which is what that key is for —
// every rule that actually matters is enforced here, not by the client.
// Two things follow from that and are worth stating plainly:
//
//   * Anything a rule allows, ANY visitor can do with nothing but the public
//     apiKey and curl. So: scores and profiles are readable by all, writable
//     only by the signed-in owner, and never updatable or deletable by
//     anyone.
//   * Anything the client sends that must not be forged (a display name, a
//     dev flag) is checked against a trusted source here rather than taken
//     on faith — Firestore rules can only allow-or-deny a write, they can't
//     rewrite it the way a Postgres trigger could, so forged values are
//     rejected outright instead of silently corrected.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------- profiles

    match /profiles/{uid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9 _-]{3,16}$')
        && request.resource.data.realName is string
        && request.resource.data.realName.size() >= 1
        && request.resource.data.realName.size() <= 60
        && request.resource.data.isDev is bool
        // The owner rule, enforced where it cannot be bypassed: isDev may
        // only be true if this uid is the one that actually won the
        // meta/owner race below.
        && request.resource.data.isDev == (
             exists(/databases/$(database)/documents/meta/owner) &&
             get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid
           );

      // Insert-once: with an update policy in place, a signed-in user could
      // simply patch isDev to true and hand themselves dev access.
      allow update, delete: if false;
    }

    // -------------------------------------------------------------- meta

    match /meta/owner {
      allow read: if true;

      // Firestore document creation is atomic per-document, so whichever
      // signed-up user's create lands first is the only one that can ever
      // succeed here — that is what makes this race safe with no
      // transaction or Cloud Function required.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/meta/owner);

      allow update, delete: if false;
    }

    // ------------------------------------------------------------ scores

    // Shared by create and update: everything except the doc-id and
    // improvement checks, which differ between the two.
    function validScoreFields() {
      return request.resource.data.userId == request.auth.uid
        // The display name is checked against the profile on file rather
        // than rewritten, so a hand-rolled request can neither post under
        // someone else's name nor invent one.
        && request.resource.data.username ==
             get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username
        && request.resource.data.game is string
        && request.resource.data.game.matches('^[a-z0-9_-]{1,32}$')
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.daily is bool;
    }

    match /scores/{scoreId} {
      allow read: if true;

      allow create: if request.auth != null
        && validScoreFields()
        && (
             (
               // A daily run is stamped with the server's own UTC day
               // number (nobody can backdate a run onto an easier board or
               // post to tomorrow early), and its document id must encode
               // that exact (uid, game, day) triple. Firestore rejects a
               // second create at the same id, which is what turns this
               // into "one daily run per player per game per day" with no
               // unique index to maintain.
               request.resource.data.daily == true &&
               request.resource.data.day == int(request.time.toMillis() / 86400000) &&
               scoreId == request.auth.uid + '_' + request.resource.data.game + '_' + string(request.resource.data.day)
             ) ||
             (
               // Free play carries one document per (player, game) — the id
               // is the identity, so a run replaces the old one instead of
               // piling up as its own row. That is also what keeps the
               // leaderboard to one entry per player instead of their whole
               // run history.
               request.resource.data.daily == false &&
               request.resource.data.day == null &&
               scoreId == request.auth.uid + '_' + request.resource.data.game
             )
           );

      // Only a free-play personal best is ever updated, and only upward —
      // a daily run's id already makes it one-shot, so there is nothing to
      // update there, and this must never allow quietly rewriting a run to
      // a worse score.
      allow update: if request.auth != null
        && validScoreFields()
        && request.resource.data.daily == false
        && request.resource.data.day == null
        && resource.data.daily == false
        && scoreId == request.auth.uid + '_' + request.resource.data.game
        && request.resource.data.score > resource.data.score;

      allow delete: if false;
    }

    // -------------------------------------------------------------- chat
    //
    // Split into two collections instead of one keyed by a roomId field, so
    // each `allow read` is a plain per-document check Firestore can verify
    // against a `list`/query request on its own — no OR of "public room" vs
    // "private room" for the rule engine to statically prove against a
    // query shape. Messages carry an `expireAt` timestamp and disappear
    // once it passes — Firestore's native TTL sweep would do that for free,
    // but it needs a billing-enabled project, which this one deliberately
    // isn't. So instead, `allow delete` opens up only once a message's own
    // expireAt is in the past, and nova.js's chatRows deletes exactly those
    // as a side effect of reading a room, which is what keeps a
    // long-running chat from growing storage forever with no Cloud
    // Function or paid plan required.
    //
    // Shared by both: the sender and display name must be the caller's own
    // (checked against the profile on file, same as scores above), the text
    // is bounded, and expireAt/createdAt must be real timestamps with
    // expireAt in the future and capped — a client cannot ask its own
    // message to outlive the cap, though it may ask for less.
    function validChatFields() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.username ==
             get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.resource.data.createdAt
        && request.resource.data.expireAt <= request.time + duration.value(2, 'd');
    }

    match /globalChat/{msgId} {
      allow read: if true;
      allow create: if request.auth != null && validChatFields();
      // Anyone signed in may delete a message once it has actually expired
      // — there is nothing left to protect in an expired message, and this
      // is what lets whichever reader arrives next do the sweeping. Not
      // "expired for me": resource.data.expireAt is compared against the
      // server's own request.time, so a client cannot delete a message
      // early by lying about what time it is.
      allow delete: if request.auth != null && request.time > resource.data.expireAt;
      allow update: if false;
    }

    match /dmMessages/{msgId} {
      // A `list` query must filter `participants array-contains
      // request.auth.uid` for Firestore to accept this rule on a query
      // rather than only on direct-by-id reads — see nova.js's
      // listDirectMessages, which does exactly that.
      // A participant may always read; anyone signed in may delete once a
      // message has actually expired (same expired-only reasoning as
      // globalChat above) even after they've left the conversation, so a
      // stale expired message is never stuck unsweepable.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null && request.time > resource.data.expireAt;

      allow create: if request.auth != null
        && validChatFields()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        // roomId is derived, not trusted: recomputed here from the sorted
        // pair so a client cannot address (and thus read back) a
        // conversation under a roomId that doesn't match who's actually in
        // it.
        && request.resource.data.roomId == (
             request.resource.data.participants[0] < request.resource.data.participants[1]
               ? request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
               : request.resource.data.participants[1] + '_' + request.resource.data.participants[0]
           );

      allow update: if false;
    }
  }
}
