{
  "name": "void-signal-desktop",
  "productName": "Void Signal",
  "version": "1.0.0",
  "private": true,
  "description": "A horror idle game about a derelict deep-space listening station.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.freezerunder.voidsignal",
    "productName": "Void Signal",
    "icon": "icons/icon-1024.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "icons/**/*"
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.games"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game"
    }
  }
}
